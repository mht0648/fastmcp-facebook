# ========================================================
# facebook-pages-mcp - Configuration Template
# ========================================================

# Target Facebook Page ID (Numeric ID from Page About / Transparency)
FB_PAGE_ID=your_facebook_page_id_here

# Permanent Facebook Page Access Token (requires 'pages_manage_posts' & 'pages_read_engagement')
# See docs/authentication.md for steps to generate a permanent token.
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Meta Graph API Version (defaults to v21.0)
FB_API_VERSION=v21.0

# Master Safety Switch: Set to 'true' to allow approved publishing to Facebook Page feed
ENABLE_PAGE_PUBLISHING=false

# Staged Action Expiration (Time To Live in seconds, default: 15 minutes)
STAGING_TTL_SECONDS=900

# Operational Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
